# LibScope environment variables
# LibScope does not load .env files. Export these in your shell, or put them in
# the "env" block of your MCP client config. This file is a reference only.

# Embedding provider: "local" | "ollama" | "openai" (default: "local")
LIBSCOPE_EMBEDDING_PROVIDER=local

# Ollama settings (used when the provider is "ollama")
LIBSCOPE_OLLAMA_URL=http://localhost:11434
LIBSCOPE_OLLAMA_MODEL=nomic-embed-text

# OpenAI key (used for embeddings and for the LLM).
# Precedence: LIBSCOPE_OPENAI_API_KEY > OPENAI_API_KEY > config file.
LIBSCOPE_OPENAI_API_KEY=

# LLM for `ask` / RAG: "openai" | "ollama" | "anthropic" | "passthrough"
# LIBSCOPE_LLM_PROVIDER=
# LIBSCOPE_LLM_MODEL=

# Anthropic key. Precedence: LIBSCOPE_ANTHROPIC_API_KEY > ANTHROPIC_API_KEY > config file.
# LIBSCOPE_ANTHROPIC_API_KEY=
