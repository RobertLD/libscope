# LibScope environment variables
# LibScope does not load .env files. Export these in your shell, or put them in
# the "env" block of your MCP client config. This file is a reference only.
# Every config key has a variable LIBSCOPE_<SECTION>_<FIELD>; see
# docs/reference/configuration.md for the full list.

# Embedding provider: "local" | "ollama" | "openai" (default: "local")
LIBSCOPE_EMBEDDING_PROVIDER=local

# Embedding model and server URL (the local provider ignores both)
# LIBSCOPE_EMBEDDING_MODEL=nomic-embed-text
# LIBSCOPE_EMBEDDING_URL=http://localhost:11434

# OpenAI key (used for embeddings and for the LLM).
# Precedence: LIBSCOPE_OPENAI_API_KEY > OPENAI_API_KEY > ~/.libscope/secrets.json.
LIBSCOPE_OPENAI_API_KEY=

# LLM for `ask`: "auto" (default) | "openai" | "anthropic" | "ollama" | "passthrough"
# LIBSCOPE_LLM_PROVIDER=auto
# LIBSCOPE_LLM_MODEL=
# LIBSCOPE_LLM_URL=

# Anthropic key. Precedence: LIBSCOPE_ANTHROPIC_API_KEY > ANTHROPIC_API_KEY > ~/.libscope/secrets.json.
# LIBSCOPE_ANTHROPIC_API_KEY=

# Fetching from private networks and self-signed TLS certificates (default: false)
# LIBSCOPE_INDEXING_ALLOW_PRIVATE_URLS=false
# LIBSCOPE_INDEXING_ALLOW_SELF_SIGNED_CERTS=false

# MCP server: optional toolsets ("admin" adds sync, install-pack, list-packs, reindex-documents)
# LIBSCOPE_MCP_TOOLSETS=admin

# Not config keys: active workspace, REST API key, key that encrypts stored webhook secrets
# LIBSCOPE_WORKSPACE=default
# LIBSCOPE_API_KEY=
# LIBSCOPE_SECRET_KEY=
